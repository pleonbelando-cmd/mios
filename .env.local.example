# Node 24. Use the Preview environment for the PR; do not overwrite production settings.
# Browser-visible RPC: restrict this credential to intended origins/provider limits.
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_BROWSER_KEY

# Optional separate server-only RPC. Falls back to NEXT_PUBLIC_SOLANA_RPC_URL.
SOLANA_RPC_URL=

# Server-only: random value at least 32 bytes; never prefix with NEXT_PUBLIC_.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COUPON_SECRET=

# Optional existing API credentials. No paid plan is required by this demo.
# Without Jupiter key the existing lite endpoint is used; availability must be checked.
JUPITER_API_KEY=
# Only the optional AAPLx dashboard quote uses this. Coupon valuation uses Jupiter.
PYTH_API_KEY=
